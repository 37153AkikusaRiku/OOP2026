<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="天気予報" Height="590" Width="850"
       WindowStartupLocation="CenterScreen" Background="#F0F4F8">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側：日本地図エリア -->
        <Border Grid.Column="0" Background="#E0F2FE" CornerRadius="10" Padding="15">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="現在の降水量マップ（都市をクリック）" FontSize="15" FontWeight="Bold" Foreground="#0369A1" Margin="0,0,0,8"/>

                <!-- 【追加】降水量の色見本（凡例） -->
                <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Rectangle Width="14" Height="14" Fill="#86EFAC" Stroke="#16A34A" Margin="0,0,4,0"/>
                        <TextBlock Text="0mm" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Rectangle Width="14" Height="14" Fill="#7DD3FC" Stroke="#0284C7" Margin="0,0,4,0"/>
                        <TextBlock Text="弱雨" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Rectangle Width="14" Height="14" Fill="#3B82F6" Stroke="#1D4ED8" Margin="0,0,4,0"/>
                        <TextBlock Text="本降り" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Rectangle Width="14" Height="14" Fill="#1E3A8A" Stroke="#172554" Margin="0,0,4,0"/>
                        <TextBlock Text="強い雨(5mm~)" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Canvas x:Name="JapanMapCanvas" Width="340" Height="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 各地方のポリゴンに x:Name を追加してC#から色を変えられるようにしています -->
                    <Polygon x:Name="HokkaidoPolygon" Points="245,25 275,15 315,40 310,65 280,75 260,65 245,80 235,65" Fill="#86EFAC" Stroke="#16A34A" StrokeThickness="1.5"/>
                    <Polygon x:Name="HonshuPolygon" Points="235,95 255,100 260,150 245,215 225,255 190,275 140,285 95,295 85,280 125,260 165,245 195,215 215,165 225,115" Fill="#86EFAC" Stroke="#16A34A" StrokeThickness="1.5"/>
                    <Polygon x:Name="ShikokuPolygon" Points="125,295 160,290 165,310 120,315" Fill="#86EFAC" Stroke="#16A34A" StrokeThickness="1.5"/>
                    <Polygon x:Name="KyushuPolygon" Points="75,305 105,305 100,355 75,360 65,330" Fill="#86EFAC" Stroke="#16A34A" StrokeThickness="1.5"/>
                    <Polygon x:Name="OkinawaPolygon" Points="25,405 45,395 50,410 30,420" Fill="#86EFAC" Stroke="#16A34A" StrokeThickness="1.5"/>

                    <!-- 都市クリック用ボタン -->
                    <Button Content="● 札幌" Tag="札幌" Canvas.Left="248" Canvas.Top="42" Click="MapCityButton_Click" Background="White" Foreground="#0F172A" Padding="6,2" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="● 仙台" Tag="仙台" Canvas.Left="242" Canvas.Top="155" Click="MapCityButton_Click" Background="White" Foreground="#0F172A" Padding="6,2" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="● 前橋" Tag="前橋（群馬）" Canvas.Left="180" Canvas.Top="198" Click="MapCityButton_Click" Background="White" Foreground="#0F172A" Padding="6,2" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="● 太田" Tag="太田（群馬）" Canvas.Left="238" Canvas.Top="202" Click="MapCityButton_Click" Background="White" Foreground="#0F172A" Padding="6,2" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="● 東京" Tag="東京" Canvas.Left="235" Canvas.Top="232" Click="MapCityButton_Click" Background="White" Foreground="#0F172A" Padding="6,2" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="● 名古屋" Tag="名古屋" Canvas.Left="170" Canvas.Top="252" Click="MapCityButton_Click" Background="White" Foreground="#0F172A" Padding="6,2" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="● 大阪" Tag="大阪" Canvas.Left="135" Canvas.Top="278" Click="MapCityButton_Click" Background="White" Foreground="#0F172A" Padding="6,2" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="● 広島" Tag="広島" Canvas.Left="88" Canvas.Top="265" Click="MapCityButton_Click" Background="White" Foreground="#0F172A" Padding="6,2" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="● 福岡" Tag="福岡" Canvas.Left="45" Canvas.Top="315" Click="MapCityButton_Click" Background="White" Foreground="#0F172A" Padding="6,2" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="● 那覇" Tag="那覇" Canvas.Left="20" Canvas.Top="380" Click="MapCityButton_Click" Background="White" Foreground="#0F172A" Padding="6,2" FontWeight="Bold" Cursor="Hand"/>
                </Canvas>
            </DockPanel>
        </Border>

        <!-- 右側：天気予報表示エリア -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. ヘッダー -->
            <DockPanel Grid.Row="0" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="CityComboBox" Width="130" Height="32" FontSize="15" FontWeight="Bold"
                              VerticalContentAlignment="Center" DisplayMemberPath="Name"
                              SelectionChanged="CityComboBox_SelectionChanged"/>
                    <TextBlock Text="の天気予報" FontSize="18" FontWeight="Bold" Foreground="#1E293B"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <Button x:Name="RefreshButton" Content="更新" Click="RefreshButton_Click"
                        HorizontalAlignment="Right" Padding="12,6" Background="#3B82F6" Foreground="White"
                        FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </DockPanel>

            <!-- 2. 現在の天気カード（降水量を追加） -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="現在の天気" FontSize="14" Foreground="#64748B" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="CurrentTempText" Text="-- ℃" FontSize="36" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,15,0"/>
                        <TextBlock x:Name="CurrentWeatherText" Text="読み込み中..." FontSize="20" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CurrentHumidityText" Text="湿度: -- %" FontSize="14" Foreground="#475569" Margin="0,0,15,0"/>
                        <TextBlock x:Name="CurrentWindText" Text="風速: -- m/s" FontSize="14" Foreground="#475569" Margin="0,0,15,0"/>
                        <TextBlock x:Name="CurrentPrecipText" Text="降水量: -- mm" FontSize="14" FontWeight="Bold" Foreground="#0284C7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. 7日間の天気予報リスト -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="15">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="7日間の予報" FontSize="14" Foreground="#64748B" Margin="0,0,0,10"/>

                    <ListView x:Name="DailyForecastList" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="340" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Date}" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WeatherText}" Foreground="#334155"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TemperatureRange}" Foreground="#0F172A"/>
                                    <TextBlock Grid.Column="3" Text="{Binding RainProbability}" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
