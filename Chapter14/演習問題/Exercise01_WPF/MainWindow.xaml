<Window x:Class="Exercise01_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Exercise01_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <!-- StackPanel から Grid に変更します -->
    <Grid>
        <!-- 画面を上下2つに分割する設定（上がボタン、下がテキストエリア） -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- ボタンの高さに合わせる -->
            <RowDefinition Height="*"/>
            <!-- 残りの領域をすべて使う（これで伸縮します） -->
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
        </Grid>
        
        

        <!-- 0行目（上側）にボタンを配置 -->
        <Button Content="ファイル選択" Click="Button_Click" Grid.Row="0"/>

        <!-- 1行目（下側）にTextBoxを配置。Heightを消して、縦スクロールバーを有効にします -->
        <TextBox x:Name="TextArea" 
                 Grid.Row="1"
                 TextWrapping="Wrap" 
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>