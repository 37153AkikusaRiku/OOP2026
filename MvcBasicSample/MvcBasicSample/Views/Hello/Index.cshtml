@model List<MvcBasicSample.Models.Product>;

@{
    ViewData["Title"] = "商品情報";//タブ用タイトル
    
    int pricekei = 0;
}

<h1>商品一覧</h1>
@* 件数が 0 なら説明だけを表示する *@
@if (Model.Count == 0) {
    <p>商品はありません</p>
} else {
    <p>@Model.Count 件の商品があります</p>
    <ul>
        @foreach (var product in Model) {
            <li>@product.Name @product.Price 円</li>
            pricekei += product.Price;
        }
    </ul>
}

<p>合計金額 @pricekei </p>
