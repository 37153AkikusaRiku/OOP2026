@model List<MvcBasicSample.Models.Product>
@{
    ViewData["Title"] = "商品情報"; // タブ用タイトル
    
    // 合計金額を計算するための変数を初期化
    int pricekei = 0;
}
 
<h1>商品一覧</h1>
@* Tag Helper で移動先を指定し Bootstrap で見た目を整える *@
<a asp-controller="Hello" asp-action="Index"
   class="btn btn-primary mb-3">商品一覧を表示</a>
 
@if (Model.Count == 0)
{
    <p>商品はありません</p>
}
else
{
    <p>@Model.Count 件の商品があります</p>
    <div class="row">
    @foreach (var product in Model)
    {
        // 画面に商品を表示しながら、同時に合計金額を加算する
        
            pricekei += product.Price;
        
        
        @* 狭い画面では 1 列で中程度以上の画面では 2 列にする *@
        <div class="col-12 col-md-6 mb-3">
            <div class="p-3 border rounded bg-light">
                <h2 class="h5">@product.Name</h2>
                <p class="mb-0">@product.Price 円</p>
            </div>
        </div>
    }
    </div>
}
 
<!-- 合計金額の表示（Bootstrapの太字と枠線で少し目立たせています） -->
<div class="mt-4 p-3 bg-dark text-white rounded inline-block" style="display: inline-block;">
    <h3 class="h5 mb-0">合計金額: <strong>@pricekei</strong> 円</h3>
</div>
 