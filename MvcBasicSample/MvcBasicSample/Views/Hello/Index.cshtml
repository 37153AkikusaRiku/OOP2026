@model List<MvcBasicSample.Models.Product>;

@{
    ViewData["Title"] = "挨拶";//タブ用タイトル
    string name = "田中";
    int pricekei = 0;
}

<h1>商品情報</h1>　　@*画面見出し*@
<ul>
    @foreach (var product in Model){
        <li> @product.Name @product.Price </li>
        pricekei += product.Price;
    }
</ul>

<p>合計金額 @pricekei </p>
